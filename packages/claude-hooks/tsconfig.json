{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // The hooks run straight from source with Node's built-in type stripping
    // (no build step), so imports use .ts extensions and only erasable syntax
    // (no enums, no namespaces) is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["src", "eslint.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
