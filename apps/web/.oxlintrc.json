{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../packages/oxlint-config/react.json"],
  "jsPlugins": [
    {
      "name": "repo",
      "specifier": "@repo/oxlint-config/plugins/repo-conventions"
    }
  ],
  "rules": {
    "repo/no-direct-axios": "error"
  },
  "overrides": [
    {
      // The shared client is the one place allowed to import axios.
      "files": ["src/lib/axios.ts", "src/lib/__tests__/axios.test.ts"],
      "rules": { "repo/no-direct-axios": "off" }
    },
    // design-system-kit 0.10.0 (wiring/vite/oxlint.design-system.jsonc): vendored
    // stock components, use-mobile and kit scripts.
    {
      "files": [
        "src/components/ui/**",
        "src/hooks/use-mobile.ts",
        "scripts/**"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/no-autofocus": "off",
        "react/only-export-components": "off",
        "react/set-state-in-effect": "off",
        "typescript/no-non-null-assertion": "off",
        "unicorn/prefer-string-starts-ends-with": "off",
        "unicorn/no-useless-spread": "off",
        "eslint/no-unused-vars": "off",
        "eslint/no-constant-binary-expression": "off"
      }
    }
  ]
}
