{
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^24.14.0",
    "pnpm": "10.30.3"
  },
  "private": true,
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || [ \"$LEFTHOOK\" = 0 ] || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1 || lefthook install --reset-hooks-path",
    "dev:no-docker": "turbo dev",
    "build": "turbo build",
    "compose:dev:up": "docker compose -f docker-compose-dev.yml up --build",
    "compose:dev:watch": "docker compose -f docker-compose-dev.yml watch",
    "compose:dev:down": "docker compose -f docker-compose-dev.yml down -v",
    "compose:up": "docker compose -f docker-compose.yml up --build",
    "compose:down": "docker compose -f docker-compose.yml down",
    "compose:test:up": "docker compose -f docker-compose-test.yml up --build",
    "compose:test:down": "docker compose -f docker-compose-test.yml down -v",
    "test": "turbo run test",
    "test:e2e": "./scripts/e2e-ci.sh",
    "test:e2e:ui": "./scripts/e2e-ui.sh",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "test:report": "turbo run test-report",
    "test:report:view": "pnpm test:report && open-cli packages/vitest-config/coverage/report/index.html",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:root": "oxlint --max-warnings=0 e2e *.ts *.tsx *.js *.jsx && eslint --max-warnings=0 --no-warn-ignored e2e '*.{ts,tsx,js,jsx}'",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "sbom": "export CDXGEN=packages/sbom-tools/node_modules/.bin/cdxgen && bash .github/actions/sbom-lockfile/generate.sh --mode full --name source --fetch-licenses && bash .github/actions/sbom-lockfile/generate.sh --mode prod --name web --workspace apps/web --fetch-licenses",
    "test:sbom": "node --test .github/actions/sbom-*/*.test.mjs",
    "terraform:test": "mise x -- terraform -chdir=infra init -backend=false -input=false > /dev/null && mise x -- terraform -chdir=infra test && mise x -- ./infra/tests/check_secret_waits_for_rbac.sh",
    "terraform:fmt": "mise x -- terraform -chdir=infra fmt -check -recursive",
    "terraform:validate": "mise x -- terraform -chdir=infra init -backend=false -input=false > /dev/null && mise x -- terraform -chdir=infra validate",
    "verify": "turbo run lint typecheck typecheck:root test",
    "ci:local": "bash ./scripts/ci-local/ci-local.sh",
    "ci:serve": "bash ./scripts/ci-local/serve.sh",
    "test:ci-local": "bash ./scripts/ci-local/ci-local.test.sh && bash ./scripts/ci-local/serve.test.sh",
    "check:tool-versions": "bash ./scripts/tool-versions/check-tool-versions.sh",
    "test:tool-versions": "bash ./scripts/tool-versions/check-tool-versions.test.sh",
    "check:hook-parity": "bash ./scripts/hook-parity/check-hook-parity.sh",
    "test:hook-parity": "bash ./scripts/hook-parity/check-hook-parity.test.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/oxlint-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.3.5",
    "eslint": "^10.0.3",
    "lefthook": "^2.1.14",
    "open-cli": "^8.0.0",
    "oxlint": "^1.85.0",
    "prettier": "3.8.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
